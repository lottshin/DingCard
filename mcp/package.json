{
  "name": "dingcard-mcp",
  "version": "0.61.1",
  "mcpName": "io.github.lottshin/dingcard",
  "type": "module",
  "description": "MCP server for DingCard: AI clients make posters, social cards and slide decks, check the layout and render PNG, JPG or PDF. 叮卡 MCP 服务器",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lottshin/DingCard.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/lottshin/DingCard/blob/master/docs/mcp.md",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "design",
    "poster",
    "slides",
    "social-media",
    "xiaohongshu",
    "cards",
    "dingcard"
  ],
  "bin": {
    "dingcard-mcp": "dist/index.mjs"
  },
  "files": [
    "dist/index.mjs",
    "dist/render.mjs",
    "dist/app",
    "npm-shrinkwrap.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.mjs --external:@modelcontextprotocol/sdk --external:playwright-core --external:zod --external:qrcode --banner:js='#!/usr/bin/env node' && esbuild src/render/renderer.ts --bundle --platform=node --format=esm --outfile=dist/render.mjs --external:playwright-core",
    "start": "node dist/index.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:render": "vitest run --config vitest.render.config.ts",
    "build:app": "node -e \"const fs=require('fs');fs.rmSync('dist/app',{recursive:true,force:true});fs.cpSync('../dist','dist/app',{recursive:true});fs.copyFileSync('../LICENSE','LICENSE')\"",
    "prepack": "npm --prefix .. run build && npm run build:app && npm run build && node scripts/shrinkwrap.mjs",
    "postpack": "node -e \"require('fs').rmSync('npm-shrinkwrap.json',{force:true})\"",
    "eval": "vitest run --config vitest.render.config.ts src/eval/eval.sheet.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright-core": "^1.61.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.5",
    "esbuild": "^0.21.5",
    "typescript": "^5.5.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
