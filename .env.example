# 叮卡 Docker Compose 环境变量模板
#
# 用法: cp .env.example .env，然后至少填写 JWT_SECRET。
# Docker Compose 会读取同目录的 .env。直跑后端时再参考 server/.env.example。
#
# .env 含密钥，已被 .gitignore 忽略，不要提交。

# ---- 镜像版本 ------------------------------------------------------------
# 固定发布版本，升级时按发布说明修改；不要把 latest 作为生产默认值。
DINGCARD_VERSION=0.44.0

# ---- 必填 ----------------------------------------------------------------
# JWT 签名密钥。必须是一段足够随机的长字符串,泄露=任何人可伪造登录。
# 生成一个(任选其一):
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ---- 前端存储模式 --------------------------------------------------------
# 留空 = 默认 LocalStore(浏览器本地、可离线)；直连独立后端时填其公开地址。
# Docker Compose 构建会固定注入同源 `/`，不使用这里的值。
VITE_API_BASE=

# ---- 可选(有默认值,按需覆盖)--------------------------------------------
# 登录令牌有效期。支持 7d / 24h / 30m 等写法。
JWT_EXPIRY=7d

# 每分钟全局请求上限与认证路由上限。生产默认分别为 300 / 20。
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# 每个用户的图片存储配额(字节)。默认 500MB。0 = 不限制。
USER_QUOTA_BYTES=524288000

# 图片租约时长(毫秒)。默认 24 小时；仅租约过期且未被草稿引用的图片会被回收。
IMAGE_LEASE_MS=86400000

# 单张图片上传大小上限(字节)。默认 6MB，由 Fastify 统一限制。
MAX_UPLOAD_BYTES=6291456

# 宿主机端口映射到 app:3000。首次测试可用 8080。
# 接入宿主机反代/负载均衡后改为 127.0.0.1:8080,避免绕过 HTTPS 直接访问。
# 见 docs/deployment.md。
WEB_PORT=8080

# ---- 在线图库(可选)------------------------------------------------------
# 编辑器"图库"面板走服务端代理,密钥只存服务端,不会进前端或镜像。
# 三个源都可以单独留空 = 不启用;全留空时面板自动降级到无需密钥的
# Openverse(只搜 CC0 / 公有领域授权的图片,可商用)。
#   Pixabay  https://pixabay.com/api/docs/     (PIXABAY_KEY)
#   Unsplash https://unsplash.com/developers/   (UNSPLASH_KEY)
#   Pexels   https://www.pexels.com/api/        (PEXELS_KEY)
PIXABAY_KEY=
UNSPLASH_KEY=
PEXELS_KEY=

# ---- 可选(默认关闭)-------------------------------------------------------
# 管理员看板令牌。填一段足够随机的长字符串后,打开 /admin 输入它就能看实例
# 总览(用户/作品/图片占用/分享/令牌数量);留空 = 看板完全不注册。
#   openssl rand -hex 32
# DINGCARD_ADMIN_TOKEN=
